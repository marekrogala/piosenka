{% load static %}{
  "name": "{{ name }}",
  "short_name": "{{ short_name }}",
  "description": "{{ description }}",
  "lang": "{{ lang }}",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "{{ theme_color }}",
  "background_color": "{{ background_color }}",
  "icons": [
    {
      "src": "{% static 'images/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'images/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'images/icon-maskable-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Szukaj",
      "short_name": "Szukaj",
      "url": "/szukaj/",
      "icons": [{"src": "{% static 'images/icon-192.png' %}", "sizes": "192x192", "type": "image/png"}]
    },
    {
      "name": "Śpiewnik",
      "short_name": "Śpiewnik",
      "url": "/spiewnik/",
      "icons": [{"src": "{% static 'images/icon-192.png' %}", "sizes": "192x192", "type": "image/png"}]
    }
  ]
}
